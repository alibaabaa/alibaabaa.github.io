# For optional local preview only — GitHub Pages builds the site itself and
# ignores this file. To run locally (needs Ruby):
#   bundle install
#   bundle exec jekyll serve                # site at http://127.0.0.1:4000
#   bundle exec jekyll serve --unpublished  # also renders draft/unpublished pages
source "https://rubygems.org"

# Pins Jekyll and every plugin to the exact versions GitHub Pages runs.
gem "github-pages", group: :jekyll_plugins

# Ruby 3 no longer bundles webrick, which jekyll 3.x needs for `serve`.
gem "webrick"
